#
# MongoDB 4.4 on AlmaLinux 8 (EL8).
#
# NOT generated by apply-templates.sh: ported by hand from 4.4/Dockerfile. Same layout,
# user ids, entrypoint and paths as the focal image; only the distro-specific steps differ:
#   - official MongoDB RHEL 8 RPMs instead of the Ubuntu focal debs
#   - mongod links the distro's OpenSSL 1.1.1k dynamically, which EL8 keeps patched
#     (rebuild this image to pick up OpenSSL fixes; never overwrite a tag the fleet runs)
#   - update-ca-certificates is a shim onto update-ca-trust (see that file)
#
FROM almalinux:8

# add our user and group first to make sure their IDs get assigned consistently, regardless of whatever dependencies get added
# (uid/gid 999 as in the focal image: data and ssl directories on the hosts belong to 999).
# almalinux:8 ships gid 999 = input and uid 999 = systemd-coredump, both unused in a container
# and owning no files: move them to 899 first.
RUN set -eux; \
	test -z "$(find / -xdev \( -uid 999 -o -gid 999 \) -print -quit 2>/dev/null)"; \
	if getent group 999 >/dev/null; then groupmod -g 899 "$(getent group 999 | cut -d: -f1)"; fi; \
	if getent passwd 999 >/dev/null; then usermod -u 899 "$(getent passwd 999 | cut -d: -f1)"; fi; \
	groupadd --gid 999 --system mongodb; \
	useradd --uid 999 --system --gid mongodb --home-dir /data/db mongodb; \
	mkdir -p /data/db /data/configdb; \
	chown -R mongodb:mongodb /data/db /data/configdb

RUN set -eux; \
	dnf -y upgrade; \
	dnf -y install \
		ca-certificates \
		findutils \
		jq \
		numactl \
		procps-ng \
		tzdata \
	; \
	dnf clean all; \
	rm -rf /var/cache/dnf

# grab gosu for easy step-down from root (https://github.com/tianon/gosu/releases)
ENV GOSU_VERSION 1.17
# grab "js-yaml" for parsing mongod's YAML config files (https://github.com/nodeca/js-yaml/releases)
ENV JSYAML_VERSION 3.13.1

RUN set -eux; \
	\
# download/install gosu
	case "$(uname -m)" in \
		x86_64) gosuArch='amd64' ;; \
		aarch64) gosuArch='arm64' ;; \
		*) echo >&2 "unsupported architecture: $(uname -m)"; exit 1 ;; \
	esac; \
	curl -fsSL -o /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/$GOSU_VERSION/gosu-$gosuArch"; \
	curl -fsSL -o /usr/local/bin/gosu.asc "https://github.com/tianon/gosu/releases/download/$GOSU_VERSION/gosu-$gosuArch.asc"; \
	export GNUPGHOME="$(mktemp -d)"; \
	gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys B42F6819007F00F88E364FD4036A9C25BF357DD4; \
	gpg --batch --verify /usr/local/bin/gosu.asc /usr/local/bin/gosu; \
	gpgconf --kill all; \
	rm -rf "$GNUPGHOME" /usr/local/bin/gosu.asc; \
	\
# download/install js-yaml
	mkdir -p /opt/js-yaml/; \
	curl -fsSL -o /opt/js-yaml/js-yaml.js "https://github.com/nodeca/js-yaml/raw/${JSYAML_VERSION}/dist/js-yaml.js"; \
	curl -fsSL -o /opt/js-yaml/package.json "https://github.com/nodeca/js-yaml/raw/${JSYAML_VERSION}/package.json"; \
	ln -s /opt/js-yaml/js-yaml.js /js-yaml.js; \
# TODO some sort of download verification here
	\
# download MongoDB PGP key, check its fingerprint, hand it to rpm
	export GNUPGHOME="$(mktemp -d)"; \
	curl -fsSL -o KEYS 'https://pgp.mongodb.com/server-4.4.asc'; \
	gpg --batch --import KEYS; \
	gpg --batch --export --armor '20691EEC35216C63CAF66CE1656408E390CFB1F5' > /etc/pki/rpm-gpg/RPM-GPG-KEY-mongodb-4.4; \
	test -s /etc/pki/rpm-gpg/RPM-GPG-KEY-mongodb-4.4; \
	rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-mongodb-4.4; \
	gpgconf --kill all; \
	rm -rf "$GNUPGHOME" KEYS; \
	\
# smoke test
	chmod +x /usr/local/bin/gosu; \
	gosu --version; \
	gosu nobody true

RUN mkdir /docker-entrypoint-initdb.d

ENV MONGO_PACKAGE=mongodb-org MONGO_REPO=repo.mongodb.org

ENV MONGO_MAJOR 4.4
RUN printf '%s\n' \
		"[${MONGO_PACKAGE}-${MONGO_MAJOR}]" \
		"name=MongoDB ${MONGO_MAJOR} (RHEL 8)" \
		"baseurl=https://${MONGO_REPO}/yum/redhat/8/${MONGO_PACKAGE}/${MONGO_MAJOR}/\$basearch/" \
		"gpgcheck=1" \
		"repo_gpgcheck=0" \
		"enabled=1" \
		"gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-mongodb-4.4" \
	> "/etc/yum.repos.d/${MONGO_PACKAGE}-${MONGO_MAJOR}.repo"

# https://docs.mongodb.org/v4.4/release-notes/4.4/
ENV MONGO_VERSION 4.4.31
# 06/11/2026 (packages), tag r4.4.31: https://github.com/mongodb/mongo/commit/cfe43bb3f7ade50c4ee108dfc329d6d4d3318b41
# fixes CVE-2026-11933 (SERVER-128125, use-after-free in server-side JavaScript)
# mongod --version: gitVersion 0fdaf65411c54e22c8a3d708454d7450dac6b6bf

RUN set -eux; \
	dnf -y install \
		${MONGO_PACKAGE}-$MONGO_VERSION \
		${MONGO_PACKAGE}-server-$MONGO_VERSION \
		${MONGO_PACKAGE}-shell-$MONGO_VERSION \
		${MONGO_PACKAGE}-mongos-$MONGO_VERSION \
		${MONGO_PACKAGE}-tools-$MONGO_VERSION \
	; \
	dnf clean all; \
	rm -rf /var/cache/dnf /var/lib/mongo /var/log/mongodb; \
	mv /etc/mongod.conf /etc/mongod.conf.orig; \
	mongod --version | head -n 1 | grep -F "v$MONGO_VERSION"

# Debian-compatible update-ca-certificates (the fleet's compose command calls it)
RUN mkdir -p /usr/local/share/ca-certificates
COPY update-ca-certificates /usr/local/bin/

VOLUME /data/db /data/configdb

# ensure that if running as custom user that "mongosh" has a valid "HOME"
# https://github.com/docker-library/mongo/issues/524
ENV HOME /data/db

COPY docker-entrypoint.sh /usr/local/bin/
ENTRYPOINT ["docker-entrypoint.sh"]

EXPOSE 27017
CMD ["mongod"]
